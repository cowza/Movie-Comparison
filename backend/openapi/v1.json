{
  "openapi": "3.1.1",
  "info": {
    "title": "MovieComparison.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/movies": {
      "get": {
        "tags": [
          "Movies"
        ],
        "operationId": "GetMovies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieListDto"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/movies/{id}/offers": {
      "get": {
        "tags": [
          "Movies"
        ],
        "operationId": "GetMovieOffers",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieOffersDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MovieDto": {
        "required": [
          "id",
          "title",
          "year",
          "poster",
          "providers"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "poster": {
            "type": [
              "null",
              "string"
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MovieListDto": {
        "required": [
          "movies",
          "complete",
          "unavailableProviders"
        ],
        "type": "object",
        "properties": {
          "movies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovieDto"
            }
          },
          "complete": {
            "type": "boolean"
          },
          "unavailableProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MovieOffersDto": {
        "required": [
          "id",
          "title",
          "year",
          "poster",
          "bestOffer",
          "offers",
          "complete",
          "unavailableProviders"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "poster": {
            "type": [
              "null",
              "string"
            ]
          },
          "bestOffer": {
            "$ref": "#/components/schemas/OfferDto"
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferDto"
            }
          },
          "complete": {
            "type": "boolean"
          },
          "unavailableProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OfferDto": {
        "required": [
          "provider",
          "price",
          "asOf",
          "stale"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Movies"
    }
  ]
}